generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TECNICO
  ATLETA
}

enum Attrezzo {
  CL
  CM
  AN
  VT
  PP
  SB
}

enum ExerciseElementRole {
  STANDARD
  USCITA
  VOLTEGGIO
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(TECNICO)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions         Session[]
  accounts         Account[]
  createdExercises Exercise[]
  athletes         Athlete[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Athlete {
  id                       String   @id @default(uuid())
  coachId                  String
  firstName                String
  lastName                 String
  normalizedFirstName      String
  normalizedLastName       String
  birthDate                DateTime @db.Date
  tesseraNumber            String?
  normalizedTesseraNumber  String?  @unique
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  coach User @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@unique([coachId, normalizedFirstName, normalizedLastName, birthDate])
  @@index([coachId])
  @@index([coachId, normalizedLastName, normalizedFirstName])
}

model Exercise {
  id          String   @id @default(uuid())
  name        String
  attrezzo    Attrezzo
  createdById String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  elements  ExerciseElement[]

  @@index([createdById])
  @@index([createdById, attrezzo])
}

model ExerciseElement {
  id         String              @id @default(uuid())
  exerciseId String
  elementId  String
  order      Int
  role       ExerciseElementRole @default(STANDARD)
  notes      String?
  createdAt  DateTime            @default(now())

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, order])
  @@index([exerciseId])
}
